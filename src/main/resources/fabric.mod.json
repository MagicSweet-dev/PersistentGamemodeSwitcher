{
  "schemaVersion": 1,
  "id": "persistentgamemodeswitcher",
  "version": "${version}",
  "name": "PersistentGamemodeSwitcher",
  "description": "Allows to open game mode switcher even if you have no permission to do that",
  "authors": [
    "MagicSweet"
  ],
  "contributors": [
    "Piecuuu"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/persistentgamemodeswitcher",
    "issues": "https://github.com/MagicSweet-dev/PersistentGamemodeSwitcher/issues",
    "sources": "https://github.com/MagicSweet-dev/PersistentGamemodeSwitcher"
  },
  "license": "MIT",
  "icon": "assets/persistentgamemodeswitcher/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.magicsweet.fabric.persistentgamemodeswitcher.client.PersistentGamemodeSwitcherClient"
    ],
    "server": [
      "com.magicsweet.fabric.persistentgamemodeswitcher.PersistentGamemodeSwitcher"
    ]
  },
  "mixins": [
    "persistentgamemodeswitcher.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.3",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": ">=${mc_version}"
  }
}
